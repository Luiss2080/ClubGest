<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- Configuración de conexión. Pueden sobrescribirse con variables de entorno
             del mismo nombre. NO escribir contraseñas reales en este archivo versionado.
             Si ROTARY_SQL_USER está vacío se usa autenticación integrada de Windows. -->
        <add key="ROTARY_SQL_SERVER" value=".\SQLEXPRESS" />
        <add key="ROTARY_SQL_DATABASE" value="BD_ROTARY" />
        <add key="ROTARY_SQL_USER" value="" />
        <add key="ROTARY_SQL_PASSWORD" value="" />
    </appSettings>
</configuration>
